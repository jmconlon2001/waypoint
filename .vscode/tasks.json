{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db: start (podman)",
      "type": "shell",
      "command": "podman compose -f deploy/compose.yaml up -d db",
      "problemMatcher": []
    },
    {
      "label": "api: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/api/Waypoint.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/api/Waypoint.slnx"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: watch",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "run", "--project", "${workspaceFolder}/api/src/Waypoint.Api", "--launch-profile", "http"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: start",
      "type": "npm",
      "script": "start",
      "path": "web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Changes detected" },
          "endsPattern": { "regexp": "bundle generation (complete|failed)" }
        }
      }
    },
    {
      "label": "web: test",
      "type": "shell",
      "command": "npx ng test --watch=false",
      "options": { "cwd": "${workspaceFolder}/web" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "web: build",
      "type": "shell",
      "command": "npx ng build",
      "options": { "cwd": "${workspaceFolder}/web" },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
