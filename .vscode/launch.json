{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/api/src/Waypoint.Api/bin/Debug/net10.0/Waypoint.Api.dll",
      "cwd": "${workspaceFolder}/api/src/Waypoint.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Web (ng serve + Edge)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "web: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/web"
    },
    {
      "name": "Web (ng serve + Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (API + Web)",
      "configurations": ["API (.NET)", "Web (ng serve + Edge)"],
      "stopAll": true
    }
  ]
}
