# Copy to deploy/.env to override the defaults used by compose.yaml.
WAYPOINT_DB_NAME=waypoint
WAYPOINT_DB_USER=waypoint
WAYPOINT_DB_PASSWORD=change-me
WAYPOINT_DB_PORT=5432
WAYPOINT_API_PORT=8081
WAYPOINT_WEB_PORT=8080

# Calendar (Phase 2). Google OAuth "Desktop app" client from Google Cloud console (README: Calendar setup).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fallback: Google Calendar > Settings > your calendar > "Secret address in iCal format". Treat it like a password.
CALENDAR_ICAL_URL=
CALENDAR_SYNC_MINUTES=15
